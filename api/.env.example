# Incel Portal API settings, grouped by area. Copy .env.example to .env to start.

# --- Core. Production needs DJANGO_DEBUG=False, a real secret key and its own hosts and origins.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
PORTAL_BASE_URL=http://localhost:3000
ADMIN_ALLOWED_IPS=127.0.0.1
TRUSTED_PROXY_COUNT=1
APP_TIME_ZONE=Africa/Lagos
LOG_LEVEL=INFO

# --- Database (PostgreSQL).
DB_NAME=incel_portal_db
DB_USER=incel_portal_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Redis: Celery, cache and chat delivery, each on its own database number.
# Empty CACHE_URL / CHANNEL_LAYER_URL means in-process only; production needs both.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_SOFT_TIME_LIMIT=540
CELERY_TASK_TIME_LIMIT=600
CACHE_URL=
CHANNEL_LAYER_URL=

# --- Sign-in and accounts. Times are in seconds.
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_SECONDS=900
LOGIN_ACCOUNT_MAX_ATTEMPTS_PER_HOUR=50
LOGIN_THROTTLE_RATE=25/minute
PASSWORD_RESET_TIMEOUT=3600
ACCOUNT_SETUP_LINK_TIMEOUT=259200
PASSWORD_RESET_EMAILS_PER_HOUR=3
AUDIT_AUTH_FAILURE_RETENTION_DAYS=90

# --- Email. EMAIL_DEBUG=True logs emails instead of sending them.
EMAIL_ENABLED=True
EMAIL_DEBUG=True
SEND_EMAILS_CELERY=False
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@localhost
EMAIL_SENDER_NAME=Incel Portal
EMAIL_TIMEOUT=15
# EMAIL_FILE_PATH=

# --- Storage (S3 or S3-compatible). boto3 reads the AWS key pair directly.
AWS_S3_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_OBJECT_ACL=private
VERIFY_UPLOADS=True

# --- Uploads: folders, link lifetimes (seconds) and limits (bytes).
# Locally, keep every folder under development/ so it stays apart from production files.
TASK_ATTACHMENT_S3_PREFIX=development/task-attachments
TASK_ATTACHMENT_UPLOAD_URL_EXPIRES_IN=900
TASK_ATTACHMENT_DOWNLOAD_URL_EXPIRES_IN=60
TASK_ATTACHMENT_MAX_SIZE=10485760
TASK_ATTACHMENT_MAX_FILES=10
TASK_ATTACHMENT_ALLOWED_CONTENT_TYPES=image/png,image/jpeg,image/webp,application/pdf,text/plain,application/zip,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
SUPPORT_ATTACHMENT_S3_PREFIX=development/support-attachments
SUPPORT_ATTACHMENT_UPLOAD_URL_EXPIRES_IN=900
SUPPORT_ATTACHMENT_DOWNLOAD_URL_EXPIRES_IN=60
AWS_MAINTENANCE_ATTACHMENT_S3_PREFIX=development/maintenance-attachments
AWS_MAINTENANCE_ATTACHMENT_UPLOAD_URL_EXPIRES_IN=900
MAINTENANCE_ATTACHMENT_DOWNLOAD_URL_EXPIRES_IN=300
AWS_INVENTORY_PHOTO_S3_PREFIX=development/inventory/photos
AWS_INVENTORY_PHOTO_UPLOAD_URL_EXPIRES_IN=900
AWS_APPLICATION_LOGO_S3_PREFIX=development/application-logos
AWS_APPLICATION_LOGO_UPLOAD_URL_EXPIRES_IN=900
AWS_PROFILE_PHOTO_S3_PREFIX=development/profile-photos
SUMMARY_PDF_EXPORT_S3_PREFIX=development/pdf-exports

# --- Chat. Forwarding copies files inside the bucket, so the AWS key needs read and write on the chat folder.
CHAT_ATTACHMENT_S3_PREFIX=development/chat-attachments
CHAT_ATTACHMENT_MAX_SIZE=26214400
CHAT_UPLOAD_URL_EXPIRES_IN=900
CHAT_DOWNLOAD_URL_EXPIRES_IN=300
CHAT_STORAGE_COPY=true

# --- Push notifications. Empty VAPID keys turn push off.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@localhost
SEND_PUSH_CELERY=True
WEB_PUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,.push.apple.com,.notify.windows.com
WEB_PUSH_TIMEOUT_SECONDS=10

# --- Other features (days, and missed recurring runs to catch up).
SUMMARY_SHARE_LINK_DAYS=30
SUPPORT_AUTO_CLOSE_DAYS=7
RECURRING_MAX_CATCH_UP_RUNS=1

# --- Tests only; not used by the running app.
TEST_USE_SQLITE=true
# TEST_DB_NAME=
# UPDATE_ROUTE_TABLE=1
# RBAC_MATRIX_PRINT=1
