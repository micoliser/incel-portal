# Incel Portal web app settings, grouped by area. Copy .env.example to .env to start.

# --- API and chat addresses, fixed into the app at build time (Docker build arguments in production).
# Empty NEXT_PUBLIC_CHAT_WS_URL uses the API's origin.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_CHAT_WS_URL=

# --- Storage hosts next/image may load from, read by next.config.ts at start. Same values as the API.
AWS_S3_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_ENDPOINT_URL=

# --- End-to-end tests. Playwright does not read this file: set these in the shell (see e2e/README.md).
# E2E_WEB_PORT=3100
# E2E_API_PORT=8100
# E2E_REUSE_SERVERS=1
# E2E_SKIP_BUILD=1
# E2E_CHROMIUM_PATH=
# E2E_PYTHON=
# E2E_DB_NAME=incel_portal_e2e
# CI=
